{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Owner')"
      }
    },
    "projects": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["managerId", "status"]
    },
    "tasks": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["projectId", "assignedTo", "status"]
    },
    "settings": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && $uid === auth.uid"
      }
    },
    "activity": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp", "userId"]
    }
  }
}
